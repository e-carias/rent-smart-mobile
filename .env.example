# Copia este archivo como .env y ajusta la dirección del API.
#
# La app móvil consume el MISMO API REST del proyecto web (Etapa 2).
#
#  - Si ya desplegaste el proyecto en Vercel, usa la URL pública:
#      EXPO_PUBLIC_API_URL=https://tu-proyecto.vercel.app/api
#
#  - Si el proyecto web corre en tu computadora, usa la IP de tu red local.
#    "localhost" NO sirve: el teléfono lo interpretaría como él mismo.
#    Averigua tu IP con `ipconfig` en Windows (Dirección IPv4).
#      EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
#
# Si la variable no está definida, o el API no responde, la aplicación usa
# los datos de demostración incluidos en src/datos/demo.js y lo indica en
# pantalla con un aviso.

EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api
