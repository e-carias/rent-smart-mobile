# ---------------------------------------------------------------------------
#  RENT SMART · Exclusiones comunes a las dos aplicaciones
# ---------------------------------------------------------------------------
# Cada carpeta tiene además su propio .gitignore con lo específico de su
# herramienta (web/.gitignore para Next.js, mobile/.gitignore para Expo).

# Dependencias
node_modules/

# Variables de entorno: NUNCA se versionan. Solo los archivos de ejemplo.
.env
.env.*
!.env.example

# Credenciales de servicio de Firebase
serviceAccountKey.json
google-services.json
GoogleService-Info.plist
*.keystore
*.jks

# Compilados y cachés
.next/
dist/
build/
coverage/
.expo/
.turbo/
*.tsbuildinfo

# Herramientas de despliegue
.vercel
.firebase/
firebase-debug.log

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Registros
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
